# Tauri rewrites these on every build, always with LF endings. Check them out
# with LF too: with core.autocrlf=true a CRLF checkout differs in size from the
# rebuilt file, and git then lists it as modified although nothing changed.
crates/mycli-desktop/gen/schemas/** text eol=lf
crates/mycli-desktop/permissions/autogenerated/** text eol=lf
