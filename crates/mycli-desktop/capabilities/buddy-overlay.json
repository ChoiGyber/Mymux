{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "buddy-overlay",
  "description": "Trusted local buddy overlay webview with only the two custom commands it invokes.",
  "local": true,
  "webviews": ["buddy-overlay"],
  "permissions": [
    "core:event:allow-listen",
    "allow-buddy-overlay-hide",
    "allow-buddy-overlay-focus-main"
  ]
}
